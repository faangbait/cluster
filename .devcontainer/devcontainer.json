
{
    "name": "cluster",
    "image": "faangbait/workspaces:devops",
    "containerEnv": {},
    "customizations": {
        "vscode": {
            "extensions": [],
            "settings": {
                "redhat.telemetry.enabled": false,
                "vs-kubernetes": {
                    "vs-kubernetes.kubectlVersioning": "infer",
                    "vs-kubernetes.knownKubeconfigs": ["~/.kube/config"]
                },
                "vscode-kubernetes.kubectl-path-linux": "/usr/local/bin/kubectl"

            }
        }
    },
    "features": {
        "ghcr.io/faangbait/dnf-features/kubectl-helm-minikube:1": {
            "version": "1.36.3",
            "minikube": "none"
        }
    },
    "postCreateCommand": {
        "install-pyinfra": "uv tool install pyinfra"
    },
    "runArgs": [
        "--add-host=k8s-control-plane-lb:10.0.8.254",
        "--add-host=node1:10.0.8.254",
        "--add-host=node2:10.0.8.253",
        "--add-host=node3:10.0.8.252",
        "--add-host=node4:10.0.8.251"
    ],
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.kube,target=/usr/local/share/kube-localhost,type=bind,readonly"
    ],
    "remoteEnv": {
        "K8S_VERSION" : "1.36.3"
    }
}
