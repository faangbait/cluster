{
	"name": "Kubernetes - Local Configuration",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",

	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"enableNonRootDocker": "true",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"version": "1.28",
			"helm": "latest",
			"minikube": "none"
		},
		"./local-features/copy-kube-config": {}
	},

	"remoteEnv": {
		"SYNC_LOCALHOST_KUBECONFIG": "true",
		"K8S_VERSION" : "1.34.2"
	},

	"initializeCommand": "cd .devcontainer && bash ensure-mount-sources",
	"mounts": [
		{
			"source": "${env:HOME}${env:USERPROFILE}/.kube",
			"target": "/usr/local/share/kube-localhost",
			"type": "bind"
		}
	],
	"runArgs": [
		"--add-host", "k8s-control-plane-lb:10.0.8.254",
		"--add-host", "node1:10.0.8.254",
		"--add-host", "node2:10.0.8.253",
		"--add-host", "node3:10.0.8.252",
		"--add-host", "node4:10.0.8.251"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-kubernetes-tools.vscode-kubernetes-tools"
			]
		}
	},
	"postAttachCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/user-setup.sh"

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "kubectl version",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
